# Backend environment variables
# Copy this file to .env and ONLY include lines where you have a value.
# Leave out any line you don't need — don't leave keys with empty values,
# as that causes parsing errors for typed fields (e.g. integers).

# Required: Groq API key for LLM calls
# Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required (from Stage 6): Tavily API key for web search (salary estimate)
# Get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional overrides (defaults shown):
# ENVIRONMENT=development
# GROQ_MODEL=llama-3.3-70b-versatile
# RATE_LIMIT_PER_DAY=10
# ALLOWED_ORIGINS=*
